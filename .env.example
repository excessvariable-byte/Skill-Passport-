# Copy to .env.local. Fill these from Supabase > Project Settings / Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set the exact public origin (no path), e.g. https://your-app.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Python inference. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
